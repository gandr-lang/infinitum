/target
**/*.rs.bk
rustc-ice-*.txt

# Tool-local state written into the tree, none of it project content: rumdl's
# formatter cache and the changelog formatter's candidate file, which is
# installed over CHANGELOG.md only when its bytes differ. `.mise/locks` is
# absent from this list: mise's version-2 lockfile keeps each npm tool's
# resolved tree in a sidecar under it, so those files are lock content and are
# tracked with mise.lock.
/.rumdl_cache/
/.git-cliff-output
